# Godot 4 项目缓存与导入
.godot/

# 导出产物（GitHub 单文件上限 100MB，构建产物不入库；用 export_presets.cfg 自行导出）
*.exe
*.pck
*.zip
win_export/
web_export/

# 编辑器与系统
*.tmp
*.log
.DS_Store
Thumbs.db
desktop.ini

# Python 缓存（Blender 建模管线）
__pycache__/

# Godot 编辑器误在项目内生成的本地数据(editor_settings/app_userdata/export_templates)
Godot/

# 本地调试
user://
*.cfg.local
