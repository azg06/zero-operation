; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="零度行动"
config/description="大型多兵种征服/突破作战 FPS,Godot 4 引擎驱动。"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.059, 0.078, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

G="*res://src/autoload/g.gd"
AudioSys="*res://src/autoload/audio_sys.gd"
GraphicsQuality="*res://src/autoload/graphics_quality.gd"

[debug]

gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/integer_used_as_enum=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=2560
window/size/window_height_override=1600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("sky_3d")

[rendering]

driver/threads/thread_model=2
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
environment/volumetric_fog/volume_size=32
occlusion_culling/use_occlusion_culling=true
environment/screen_space_reflection/roughness_quality=1
occlusion_culling/occlusion_culling_size=256

[xr]

shaders/enabled=true
