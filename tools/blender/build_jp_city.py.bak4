def _fill_batch():
    """按区位风格铺填空建筑。**每栋即时 join 成单件** —— 否则几千个物体最终进一次大 join,
    Blender 的 object.join 是超线性的,Z9 会卡十几分钟。每 7 个点位改做小停车场。"""
    rng = __import__("random").Random(20260910)
    P = []
    J.BEVEL_SCALE = 0.0            # 填充楼关倒角:通用盒子, 航拍看不到 2cm 倒角, 省一半面数
    for i, (x, z) in enumerate(FILL_SPOTS):
        q = []
        if i % 7 == 6:
            # 小停车场(划线 + 2 台车 + 路灯)
            q.append(slab("z9_fp%d" % i, x - 11, x + 11, z - 9, z + 9, y=0.06, t=0.05, mat="asphalt_w"))
            for k in range(4):
                q.append(slab("z9_fpl%d_%d" % (i, k), x - 8 + k * 4, x - 7.6 + k * 4, z - 7, z + 7,
                              y=0.075, t=0.02, mat="paint_w"))
            q += _car("z9_fpc%d0" % i, x - 6, z - 4, 0.0, body="sign_b")
            q += _car("z9_fpc%d1" % i, x + 6, z + 4, 0.0, body="metal")
            q += street_lamp("z9_fplamp%d" % i, x - 12.5, z, 5.2, rot_z=1.57)
        else:
            # 风格按区位判定
            if z < -340 or (x < -340 and z < -240):       # 临海带/西南工业角 -> 仓库厂房
                w_, d_, h_ = rng.uniform(16, 26), rng.uniform(12, 20), rng.uniform(6.5, 10.0)
                mat_, roof_ = ("concrete_d" if i % 2 else "metal_d"), "flat"
            elif x < -80 and z < 240:                     # 神社东侧/商店街西 -> 町屋
                w_, d_, h_ = rng.uniform(10, 13), rng.uniform(8, 11), rng.uniform(4.0, 5.2)
                mat_, roof_ = "wood_b", "gable"
            elif x > 95 and z > 215:                      # 住宅区 -> 一户建
                w_, d_, h_ = rng.uniform(8.5, 11.5), rng.uniform(8.5, 11.5), rng.uniform(5.2, 6.6)
                mat_, roof_ = ("plaster" if i % 2 else "wood_b"), "gable"
            elif abs(x) <= 95:                             # 中央商业带 -> 商铺
                w_, d_, h_ = rng.uniform(12, 18), rng.uniform(10, 15), rng.uniform(8.0, 13.0)
                mat_, roof_ = ("plaster" if i % 2 else "brick"), "flat"
            else:                                          # 其余 -> 办公楼
                w_, d_, h_ = rng.uniform(15, 22), rng.uniform(13, 19), rng.uniform(13.0, 27.0)
                mat_, roof_ = ("concrete" if i % 2 else "concrete_d"), "flat"
            q += _fillbld("z9_fb%d" % (i + 10), x, z, w_, d_, h_, enter=(i % 3 == 0),
                          mat=mat_, roof=roof_)
            if i % 4 == 1:
                q += vending_machine("z9_fbv%d" % i, x + w_ * 0.5 + 1.2, z - d_ * 0.3,
                                     rot=1.5708, kind=("soda_red" if i % 2 else "soda_blue"))
            if i % 5 == 2:
                q += sign_board("z9_fbs%d" % i, x - w_ * 0.5 - 0.9, z + d_ * 0.35, 3.0, 0.3, 1.6,
                                rot=1.5708, kind=("sign_r" if i % 2 else "sign_o"))
        m = join_parts("z9_fill%02d" % i, [o for o in q if o is not None])
        if m is not None:
            P.append(m)
    J.BEVEL_SCALE = 1.0
    return P



def build_zone_9(render=True):
    reset()
    J._zone_cols.clear()
    J._zone_walks.clear()
    P = []

    # ---------------- 路网缺口铺装 ----------------
    P.append(slab("z9_kokudo_w", -480, -340, -51, -29, y=0.05, t=0.04, mat="asphalt"))   # 国道西段
    P.append(slab("z9_kokudo_gap", 60, 100, -51, -29, y=0.05, t=0.04, mat="asphalt"))    # 国道缝(Z2-Z8)
    P.append(slab("z9_kokudo_cl0", -480, -340, 19.7, 20.3, y=0.07, t=0.02, mat="paint_y"))
    P.append(slab("z9_kendo_s", -69, -51, -480, -260, y=0.05, t=0.04, mat="asphalt"))    # 県道南段
    P.append(slab("z9_kendo_n", -69, -51, 20, 480, y=0.05, t=0.04, mat="asphalt"))       # 県道北段
    P.append(slab("z9_kendo_cl", -60.3, -59.7, 20, 150, y=0.07, t=0.02, mat="paint_w"))
    P.append(slab("z9_kendo_cl2", -60.3, -59.7, 190, 480, y=0.07, t=0.02, mat="paint_w"))
    P.append(slab("z9_ekimae0", 73, 87, -480, -51, y=0.05, t=0.04, mat="asphalt"))       # 站前大道南段(避让国道)
    P.append(slab("z9_ekimae1", 73, 87, -29, 20, y=0.05, t=0.04, mat="asphalt"))
    P.append(slab("z9_kaigan_s", 412, 428, -480, -360, y=0.05, t=0.04, mat="asphalt"))   # 海岸大道南段
    P.append(slab("z9_kaigan_n", 412, 428, 40, 480, y=0.05, t=0.04, mat="asphalt"))      # 海岸大道北段
    P.append(slab("z9_hama_w", -480, -260, -267, -253, y=0.05, t=0.04, mat="asphalt"))   # 浜通り西段
    P.append(slab("z9_hama_gap", 80, 180, -267, -253, y=0.05, t=0.04, mat="asphalt"))    # 浜通り缝(Z7-Z6)
    P.append(slab("z9_kyudo", -244, -236, -11, 16, y=0.055, t=0.04, mat="stone_d"))      # 旧街道缝
    P.append(slab("z9_kyudo_n", -244, -236, 104, 480, y=0.055, t=0.04, mat="stone_d"))   # 旧街道北段
    # 斑马线(国道 x 站前大道口)
    for i in range(6):
        P.append(slab("z9_zeb0_%d" % i, 71 + i * 2.4, 73.4 + i * 2.4, -34, -30,
                      y=0.075, t=0.02, mat="paint_w"))
        P.append(slab("z9_zeb1_%d" % i, 86.6 - i * 2.4, 89 - i * 2.4, -50, -46,
                      y=0.075, t=0.02, mat="paint_w"))

    # ---------------- 県道跨线桥(y4.5 跨铁路 z170, 步兵+轻型载具) ----------------
    P += floor_slab("z9_ovp", -69, -51, 158, 182, 4.5, 0.5, "concrete")
    P.append(solid("z9_ovp_rail0", (0.15, 1.1, 24), (-68.9, 5.05, 170), "metal", bev=0.01))
    P.append(solid("z9_ovp_rail1", (0.15, 1.1, 24), (-51.1, 5.05, 170), "metal", bev=0.01))
    for cz in (164, 176):
        c = add_cyl("z9_ovp_col%d" % cz, 1.0, 4.25, (-60, 2.125, cz), axis="y", seg=10)
        zmat(c, "concrete")
        P.append(c)
    P += stairs_z("z9_ovp_ramp_n", 128, 158, -60, 10.0, 0.0, 4.5, "concrete", up_dir="+z")
    P += stairs_z("z9_ovp_ramp_s", 182, 212, -60, 10.0, 0.0, 4.5, "concrete", up_dir="-z")
    # 铁路延伸(道砟+轨条)
    P.append(slab("z9_rail_bed_w", -480, -100, 165, 175, y=0.15, t=0.3, mat="stone_d"))
    P.append(slab("z9_rail_bed_e", 200, 480, 165, 175, y=0.15, t=0.3, mat="stone_d"))
    for lz in (-2.53, -1.47, 1.47, 2.53):
        P.append(solid("z9_railw%d" % int(lz * 10), (380, 0.12, 0.14), (-290, 0.34, 170 + lz), "metal", bev=0.0))
        P.append(solid("z9_raile%d" % int(lz * 10), (280, 0.12, 0.14), (340, 0.34, 170 + lz), "metal", bev=0.0))

    # ---------------- 高架北段(z40~480)+ 南段(z-480~-360) ----------------
    P += floor_slab("z9_elev_n0", -304, -296, 40, 260, 8.0, 0.5, "concrete")
    P += floor_slab("z9_elev_n1", -304, -296, 260, 480, 8.0, 0.5, "concrete")
    P.append(solid("z9_elev_nr0", (0.15, 1.1, 440), (-303.85, 8.55, 260), "metal", bev=0.01))
    P.append(solid("z9_elev_nr1", (0.15, 1.1, 440), (-296.15, 8.55, 260), "metal", bev=0.01))
    for gz in range(60, 480, 40):
        c = add_cyl("z9_elev_nc%d" % gz, 1.1, 7.75, (-300, 3.875, gz), axis="y", seg=10)
        zmat(c, "concrete")
        P.append(c)
        P.append(solid("z9_elev_ncap%d" % gz, (10, 0.7, 3.0), (-300, 8.15, gz), "concrete", bev=0.02))
    P += floor_slab("z9_elev_s", -304, -296, -480, -360, 8.0, 0.5, "concrete")
    P.append(solid("z9_elev_sr", (0.15, 1.1, 120), (-303.85, 8.55, -420), "metal", bev=0.01))
    P.append(solid("z9_elev_sr2", (0.15, 1.1, 120), (-296.15, 8.55, -420), "metal", bev=0.01))
    for gz in (-460, -420, -380):
        c = add_cyl("z9_elev_sc%d" % gz, 1.1, 7.75, (-300, 3.875, gz), axis="y", seg=10)
        zmat(c, "concrete")
        P.append(c)
        P.append(solid("z9_elev_scap%d" % gz, (10, 0.7, 3.0), (-300, 8.15, gz), "concrete", bev=0.02))

    # ---------------- 红绿灯 x8 路口(对角 2 盏) ----------------
    lights = [(-60, -40, 0.0), (-240, -40, 0.0), (80, -40, 0.0), (420, -40, 0.0),
              (-60, -260, 1.57), (420, -260, 1.57), (-240, 170, 0.0), (80, -260, 1.57)]
    for li, (lx, lz, lr) in enumerate(lights):
        P += _tlight("z9_tl%d" % li, lx - 13, lz - 13, lr)
        P += _tlight("z9_tlb%d" % li, lx + 13, lz + 13, lr + 3.14159)

    # ---------------- 填充楼 x6(国道南侧空隙带, 可进 2) ----------------
    P += _fillbld("z9_fb0", -30, -85, 14, 14, 16, False)
    P += _fillbld("z9_fb1", 0, -85, 12, 12, 12, True)
    P += _fillbld("z9_fb2", 30, -85, 14, 14, 20, False)
    P += _fillbld("z9_fb3", -30, 0, 14, 14, 14, False)
    P += _fillbld("z9_fb4", 0, 0, 12, 12, 18, True)
    P += _fillbld("z9_fb5", 30, 0, 14, 14, 12, False)
    # ---------- 全图基底铺装:补分区地面未覆盖的 21.4% 空区 ----------
    # 顶面 -0.02:正好压在各分区地面(y0~0.03)之下,只在缝隙处露出,杜绝"兜底泥地透出来"
    P.append(slab("z9_base", -480, 480, -480, 480, y=-0.02, t=0.03, mat="asphalt_w"))
    # ---------- 海岸:環島護岸(内侧 ±478,与 G.bounds 对齐) ----------
    P.append(solid("z9_quay_n", (966, 5.4, 5.0), (0, -2.25, -480.5), "concrete_d"))
    P.append(solid("z9_quay_s", (966, 5.4, 5.0), (0, -2.25, 480.5), "concrete_d"))
    P.append(solid("z9_quay_w", (5.0, 5.4, 966), (-480.5, -2.25, 0), "concrete_d"))
    P.append(solid("z9_quay_e", (5.0, 5.4, 966), (480.5, -2.25, 0), "concrete_d"))
    # 護岸压顶(露出水面的一圈灰边)+ 内侧栏杆
    for qn, (qx, qz, qw, qd) in {
            "n": (0, -477.0, 960, 1.6), "s": (0, 477.0, 960, 1.6),
            "w": (-477.0, 0, 1.6, 960), "e": (477.0, 0, 1.6, 960)}.items():
        P.append(solid("z9_qcap_" + qn, (qw, 0.5, qd), (qx, 0.25, qz), "concrete"))
    # 消波块(护岸外侧水面,两排错位)
    for pi, pz in enumerate(range(-460, 470, 26)):
        for k in (-1, 1):
            P.append(solid("z9_tetra_w%d_%d" % (pi, k), (3.2, 3.2, 3.2),
                           (-486.0 - (0 if k < 0 else 4.0), 0.4, pz), "concrete_d", bev=0.6))
    for pi, px in enumerate(range(-460, 470, 30)):
        P.append(solid("z9_tetra_s%d" % pi, (3.2, 3.2, 3.2), (px, 0.4, 486.5), "concrete_d", bev=0.6))
    for pi, px in enumerate(range(-430, 470, 34)):
        P.append(solid("z9_tetra_e%d" % pi, (3.2, 3.2, 3.2), (486.5, 0.4, px), "concrete_d", bev=0.6))
    # 海岸道路带(南缘,兼作载具通道)
    P.append(slab("z9_coastro", -470, 470, -450, -436, y=0.05, t=0.04, mat="asphalt"))
    # 城市填空批:80 处空旷街区补建筑(数据驱动选点,避让路网/旗点/保留区)
    P += _fill_batch()
    for k, (sx, sz) in enumerate([(-15, -60), (15, -60), (-15, 20), (15, 20)]):
        P += vending_machine("z9_vend%d" % k, sx, sz, rot=180.0 if k < 2 else 0.0,
                             kind="soda_red" if k % 2 else "soda_blue")
    P += wreck_car("z9_wreck0", -50, -60, 0.3)
    P += jersey_barrier("z9_jb0", -10, -60, 2.0, 0.1)
    P += sandbag_wall("z9_sb0", 40, -60, 3.0, 0.0)

    # ---------------- 公车站 x4 ----------------
    for bi, (bx, bz, br) in enumerate([(-100, -32, 0.0), (140, -48, 3.14), (420, -120, 1.57), (-30, -248, 0.0)]):
        P.append(solid("z9_bus%d_plat" % bi, (6.0, 0.15, 2.4), (bx, 0.1, bz), "concrete", bev=0.01))
        for k in range(2):
            c = add_cyl("z9_bus%d_c%d" % (bi, k), 0.08, 2.6, (bx - 2.4 + k * 4.8, 1.3, bz), axis="y", seg=6)
            zmat(c, "metal_d")
            P.append(c)
        P.append(slab("z9_bus%d_roof" % bi, bx - 3.2, bx + 3.2, bz - 1.2, bz + 1.2,
                      y=2.7, t=0.1, mat="metal"))
        P += sign_board("z9_bus%d_sign" % bi, bx + 3.3, bz, 1.7, 0.7, 1.5, rot=90.0, kind="sign_b")

    # ---------------- 导出 + 渲染 ----------------
    os.makedirs(MODEL_DIR, exist_ok=True)
    os.makedirs(SHOT_DIR, exist_ok=True)
    zone_export("akitsu_z9", P, MODEL_DIR + "/zone_9.glb")
    if render:
        zone_render("z9", (0, 0, 0), 170, SHOT_DIR + "/zone9",
                    extra_shots=[("cross", (-30, 2.0, -70), (-60, 3.0, -120)),
                                 ("overpass", (-30, 1.8, 140), (-60, 4.0, 175))])


# ============================================================ Z10 边缘+基地(局部=绝对, 原点 0,0)
# US 基地 (-430,-420) / RU 基地 (+430,+420): 沙袋围线+帐篷×4+指挥帐+弹药箱+哨塔+卡车;
# 西缘稻田 6 格(x[-474,-426] z[-150,-60]); 北缘杉林带(z[+440,+478])。

def _tent(name, x, z, rot=0.0, w=4.0, l=6.0, h=2.2):
    """军用帐篷(两斜面屋面板+背山墙)。col 罩盒。"""
    P = []
    r = math.radians(rot)
    px = math.cos(r)
    pz = -math.sin(r)
    for s in (-1, 1):
        slope = add_box("%s_s%d" % (name, 1 if s > 0 else 0),
                        (l, 0.1, w * 0.62), (x, h * 0.55, z), bevel=0.0, rot_g=(0, r, 0))
        slope.rotation_euler = rot_g2b((s * math.atan2(h, w / 2.0), r, 0))
        slope.location = g2b((x - pz * s * w * 0.25, h * 0.55, z + px * s * w * 0.25))
        zmat(slope, "tent")
        P.append(slope)
    back = add_box("%s_b" % name, (w * 0.55, h * 0.9, 0.12), (x, h * 0.45, z), bevel=0.0, rot_g=(0, r, 0))
    back.location = g2b((x + px * l / 2.0 * (1 if rot >= 0 else -1), h * 0.45,
                         z + pz * l / 2.0))
    zmat(back, "tent")
    P.append(back)
    J.col(name, (abs(px) * l + abs(pz) * w + 0.4, h, abs(pz) * l + abs(px) * w + 0.4), (x, h / 2.0, z))
    return P


def _base(name, cx, cz, rot=180.0):
    """前進基地(围线+帐篷群+哨塔+卡车)。rot=朝向。"""
    P = []
    r = math.radians(rot)
    ca, sa = math.cos(r), math.sin(r)

    def W(dx, dz):
        return (cx + ca * dx + sa * dz, cz - sa * dx + ca * dz)

    # 砾石地面
    gx, gz = W(0, 0)
    P.append(slab(name + "_ground", gx - 35, gx + 35, gz - 30, gz + 30, y=0.04, t=0.06, mat="sand"))
    # 沙袋围线(仅朝战场两面, 另两面靠地图边)
    segs = [(-30, 26, 60, 0.0), (30, -26, 52, 1.57)]
    for si, (dx, dz2, ln, lr) in enumerate(segs):
        wx, wz = W(dx, dz2)
        P += sandbag_wall("%s_per%d" % (name, si), wx, wz, ln, lr + r)
    # 帐篷 x4 + 指挥帐
    for ti, (dx, dz2, tr) in enumerate([(-18, -12, 0.0), (-6, -12, 0.0), (6, -12, 0.0), (18, -12, 0.0)]):
        tx, tz = W(dx, dz2)
        P += _tent("%s_tent%d" % (name, ti), tx, tz, tr + r)
    cmdx, cmdz = W(0, 8)
    P += _tent(name + "_cmd", cmdx, cmdz, r, w=7.0, l=9.0, h=3.0)
    # 弹药箱堆 x2 + 油桶 x3
    for ai, (dx, dz2) in enumerate([(-24, 10), (-21, 13)]):
        ax, az = W(dx, dz2)
        for k in range(3):
            P.append(solid("%s_ammo%d_%d" % (name, ai, k), (1.0, 0.5, 0.6),
                           (ax, 0.25 + (k % 2) * 0.52, az + (k // 2) * 0.7), "wood_b", bev=0.02,
                           rot=(0, r + k * 0.2, 0)))
    for oi, (dx, dz2) in enumerate([(24, 12), (26, 10), (25, 14)]):
        ox, oz = W(dx, dz2)
        c = add_cyl("%s_barrel%d" % (name, oi), 0.35, 0.95, (ox, 0.48, oz), axis="y", seg=10)
        zmat(c, "metal_d" if oi != 1 else "rust")
        P.append(c)
    # 哨塔(4 柱+平台 y3+顶)
    tx, tz = W(26, -18)
    for k, (dx, dz2) in enumerate([(-1, -1), (1, -1), (-1, 1), (1, 1)]):
        P.append(solid("%s_tw_p%d" % (name, k), (0.25, 3.4, 0.25),
                       (tx + dx * 1.4, 1.7, tz + dz2 * 1.4), "wood_d", bev=0.01))
    P += floor_slab("%s_tw_plat" % name, tx - 2.0, tx + 2.0, tz - 2.0, tz + 2.0, 3.4, 0.15, "wood_d")
    P.append(slab("%s_tw_roof" % name, tx - 2.4, tx + 2.4, tz - 2.4, tz + 2.4, y=5.6, t=0.15, mat="tent"))
    for k in range(4):
        P.append(solid("%s_tw_r%d" % (name, k), (4.0 if k < 2 else 0.1, 0.9, 0.1 if k < 2 else 4.0),
                       (tx + (0 if k < 2 else (-2 + k * 2) * 0 + (k - 2.5) * 1.3), 3.85,
                        tz + ((k - 1.5) * 1.3 if k < 2 else 0)),
                       "wood_d", bev=0.01))
    # 卡车 + 灯杆 x2
    tkx, tkz = W(18, 16)
    P += _truck(name + "_trk", tkx, tkz, rot + 90.0, cab="sign_o")
    for li, (dx, dz2) in enumerate([(-28, 20), (10, -20)]):
        lx, lz = W(dx, dz2)
        pole = add_cyl("%s_lamp%d" % (name, li), 0.08, 6.0, (lx, 3.0, lz), axis="y", seg=6)
        zmat(pole, "metal_d")
        P.append(pole)
        P.append(deco("%s_lamp%d_h" % (name, li), (0.5, 0.15, 0.3), (lx, 6.0, lz), "lamp"))
    return P


def build_zone_10(render=True):
    reset()
    J._zone_cols.clear()
    J._zone_walks.clear()
    P = []

    # ---------------- 地表(边缘带基底) ----------------
    P.append(slab("z10_ground_s", -480, 480, -480, -440, y=0.03, t=0.05, mat="grass"))
    P.append(slab("z10_ground_w", -480, -440, -440, 480, y=0.03, t=0.05, mat="grass"))
    P.append(slab("z10_ground_n", -480, 480, 440, 480, y=0.03, t=0.05, mat="grass"))
    P.append(slab("z10_ground_e", 440, 480, -440, 440, y=0.03, t=0.05, mat="grass"))

    # ---------------- 西缘稻田 6 格 ----------------
    for ri in range(3):
        for ci in range(2):
            fx = -474 + ci * 26
            fz = -140 + ri * 32
            P.append(slab("z10_paddy%d_%d" % (ri, ci), fx, fx + 24, fz, fz + 18,
                          y=0.08, t=0.06, mat="water"))
            # 田埂(四边)
            P.append(solid("z10_dyke%d_%d_0" % (ri, ci), (25.4, 0.4, 0.7), (fx + 12, 0.2, fz - 0.35),
                           "grass", bev=0.0))
            P.append(solid("z10_dyke%d_%d_1" % (ri, ci), (25.4, 0.4, 0.7), (fx + 12, 0.2, fz + 18.35),
                           "grass", bev=0.0))
            P.append(solid("z10_dyke%d_%d_2" % (ri, ci), (0.7, 0.4, 19.4), (fx - 0.35, 0.2, fz + 9),
                           "grass", bev=0.0))
            P.append(solid("z10_dyke%d_%d_3" % (ri, ci), (0.7, 0.4, 19.4), (fx + 24.35, 0.2, fz + 9),
                           "grass", bev=0.0))

    # ---------------- 北缘杉林带 ----------------
    for k in range(16):
        P += tree_cedar("z10_cedar%d" % k, -380 + k * 50, 452 + (k % 3) * 8, h=9.0)

    # ---------------- US / RU 前進基地 ----------------
    P += _base("z10_us", -430, -420, rot=0.0)
    P += _base("z10_ru", 430, 420, rot=180.0)
    # 基地旗标(辨识)
    for nm, bx, bz in (("us", -430, -440), ("ru", 430, 400)):
        p = add_cyl("z10_%s_flag_p" % nm, 0.09, 7.0, (bx, 3.5, bz), axis="y", seg=6)
        zmat(p, "metal")
        P.append(p)
        f = add_box("z10_%s_flag_f" % nm, (1.6, 1.0, 0.04), (bx + 0.85, 6.2, bz), bevel=0.0)
        zmat(f, "sign_r" if nm == "us" else "sign_b")
        P.append(f)
        J.col("z10_%s_flag" % nm, (0.22, 7.0, 0.22), (bx, 3.5, bz))

    # ---------------- 导出 + 渲染 ----------------
    os.makedirs(MODEL_DIR, exist_ok=True)
    os.makedirs(SHOT_DIR, exist_ok=True)
    zone_export("akitsu_z10", P, MODEL_DIR + "/zone_10.glb")
    if render:
        zone_render("z10", (0, 0, 0), 170, SHOT_DIR + "/zone10",
                    extra_shots=[("usbase", (-395, 60, -370), (-430, 0, -425)),
                                 ("paddy", (-390, 55, -30), (-450, 0, -105))])


BUILDERS = {
    "zone1": build_zone_1,
    "zone2": build_zone_2,
    "zone3": build_zone_3,
    "zone8": build_zone_8,
    "zone6": build_zone_6,
    "zone4": build_zone_4,
    "zone5": build_zone_5,
    "zone7": build_zone_7,
    "zone9": build_zone_9,
    "zone10": build_zone_10,
}


if __name__ == "__main__":
    args = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else ["zone1"]
    target = args[0]
    do_render = "norender" not in args
    if target in BUILDERS:
        BUILDERS[target](render=do_render)
    else:
        print("未知 zone: %s (可用: %s)" % (target, ", ".join(BUILDERS)))
