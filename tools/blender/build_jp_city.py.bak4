    (180.0, 52.0), (-204.0, 20.0), (-108.0, 20.0), (-204.0, -76.0), (-92.0, -76.0),
    (100.0, -76.0), (164.0, -76.0), (-28.0, -124.0), (36.0, -124.0), (-188.0, -140.0),
    (100.0, -140.0), (164.0, -140.0), (-28.0, -188.0), (36.0, -188.0), (-204.0, -204.0),
    (100.0, -204.0), (164.0, -204.0),
    # ---- 第二轮补:分区地面未覆盖的缺口区(960² 内 21.4% 空区) ----
    (231.0, 60.5), (220.5, 121.0), (279.5, 62.0), (269.0, 109.0), (328.0, 63.5),
